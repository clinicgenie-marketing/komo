---
/**
 * Concept 2: The care journey.
 * The page is organised around understanding the visit: arrival, conversation,
 * assessment where included, treatment and finish (style guide 20.3), then
 * helps a first-time visitor choose a service.
 */
import PreviewBanner from '../layout/PreviewBanner.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import ContactChannels from '../layout/ContactChannels.astro';
import ImageSlot from '../ui/ImageSlot.astro';
import AppointmentAction from '../ui/AppointmentAction.astro';
import AppointmentPanel from '../ui/AppointmentPanel.astro';
import Fact from '../ui/Fact.astro';
import Faq from '../ui/Faq.astro';
import { copy, outlet, pillars, treatments, visitSteps } from '../../data/records.ts';
import { formatDuration, formatPrice, treatmentTitle } from '../../lib/format.ts';

const nav = [
  { href: '#journey', label: 'Your visit' },
  { href: '#treatments', label: 'Choosing a treatment' },
  { href: '#approach', label: 'How it should feel' },
  { href: '#space', label: 'Finding us' },
  { href: '#faqs', label: 'FAQs' },
];

/** Practical notes per step. Facts that are not yet confirmed render as labelled placeholders. */
const stepNotes: Record<string, { text?: string; pending?: string }[]> = {
  'step-arrival': [
    { text: `KOMO is at ${outlet.address.building}, ${outlet.address.city}.` },
    { pending: 'Unit number and opening hours to be confirmed' },
  ],
  'step-conversation': [
    { text: 'It can help to think beforehand about what you have noticed and what you would like from the visit.' },
  ],
  'step-assessment': [
    { text: 'Your therapist explains what the assessment shows, in plain language.' },
    { pending: 'Which services include an assessment is to be confirmed' },
  ],
  'step-treatment': [
    { text: 'The care itself depends on the treatment you choose.' },
    { pending: 'Duration of each treatment to be confirmed' },
  ],
  'step-finish': [
    { text: 'There is time to ask any questions before you leave.' },
  ],
};
const stepRatios = ['3 / 2', '4 / 5', '3 / 2', '4 / 5', '3 / 2'];
const stepTones = ['timber', 'stone', 'sage', 'stone', 'timber'] as const;

/** Which visit step each pillar is most associated with (from the pillar's visitMoment). */
const pillarStep: Record<string, number> = { Health: 2, Joy: 4, Beauty: 5, Vitality: 5 };

const assessmentLabel = (v: boolean | null) => (v === null ? null : v ? 'Included' : 'Not included');
---
<PreviewBanner concept="Concept 2, The care journey" />
<SiteHeader nav={nav} homeHref="/concept-2/" />

<main id="main" class="c2" tabindex="-1">
  <!-- Hero: practical promise plus the visit at a glance -->
  <section class="c2-hero" aria-labelledby="c2-hero-title">
    <div class="container grid c2-hero__grid">
      <div class="c2-hero__text">
        <p class="t-eyebrow">Your first visit to KOMO</p>
        <h1 id="c2-hero-title" class="t-display">Know what happens before you arrive.</h1>
        <p class="t-lead">{copy.heroSupport.text} Here is how a visit works, from the moment you arrive to the moment you leave.</p>
        <div class="button-row">
          <a class="komo-button" href="#treatments">Explore treatments</a>
          <AppointmentAction variant="secondary" placement="hero" />
        </div>
      </div>
      <nav class="c2-glance" aria-labelledby="c2-glance-title">
        <p id="c2-glance-title" class="c2-glance__title">Your visit at a glance</p>
        <ol role="list" class="c2-glance__list">
          {visitSteps.map((s) => (
            <li>
              <a href={`#step-${s.order}`} class="c2-glance__link">
                <span class="c2-glance__num" aria-hidden="true">{s.order}</span>
                <span>
                  <span class="c2-glance__step">{s.title}</span>
                  <span class="c2-glance__short">{s.short}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
    <div class="container">
      <ImageSlot
        class="c2-hero__image"
        assetId="flow-architecture"
        ratio="21 / 9"
        ratioMobile="4 / 3"
        tone="timber"
        loading="eager"
        sizes="(min-width: 1240px) 1200px, 100vw"
      />
    </div>
  </section>

  <!-- The journey: numbered timeline with process imagery -->
  <section id="journey" class="section c2-journey" aria-labelledby="c2-journey-title">
    <div class="container">
      <div class="c2-journey__head">
        <p class="t-eyebrow">Your visit</p>
        <h2 id="c2-journey-title" class="t-h2">A visit, step by step</h2>
        <p>{copy.experienceIntro.text} The exact steps depend on the service you choose.</p>
      </div>
      <ol role="list" class="c2-steps">
        {visitSteps.map((s, i) => (
          <li id={`step-${s.order}`} class:list={['c2-step', { 'c2-step--reverse': i % 2 === 1 }]}>
            <div class="c2-step__marker" aria-hidden="true"><span>{s.order}</span></div>
            <div class="c2-step__content">
              <p class="c2-step__count">Step {s.order} of {visitSteps.length}</p>
              <h3 class="t-h2 c2-step__title">{s.title}</h3>
              {s.conditional && <p><span class="tag">{s.conditionNote}</span></p>}
              <p class="c2-step__detail">{s.detail}</p>
              <div class="c2-step__notes">
                <p class="c2-step__notes-title">Good to know</p>
                <ul>
                  {stepNotes[s.id]?.map((n) => (
                    <li>{n.text ?? <Fact value={null} pending={n.pending!} />}</li>
                  ))}
                </ul>
              </div>
            </div>
            <ImageSlot class="c2-step__image" assetId={s.assetId} ratio={stepRatios[i]} ratioMobile="3 / 2" tone={stepTones[i]} sizes="(min-width: 1024px) 480px, 100vw" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Choosing a treatment: comparison table, stacked on small screens -->
  <section id="treatments" class="section c2-choose" aria-labelledby="c2-choose-title">
    <div class="container">
      <div class="c2-choose__head">
        <p class="t-eyebrow">Choosing a treatment</p>
        <h2 id="c2-choose-title" class="t-h2">Which treatment suits you?</h2>
        <p>Three kinds of care, each beginning with a conversation. Compare them side by side.</p>
      </div>
      <table class="c2-table">
        <caption class="visually-hidden">Comparison of KOMO treatment options</caption>
        <thead>
          <tr>
            <th scope="col">Treatment</th>
            <th scope="col">Suited to</th>
            <th scope="col">Scalp assessment</th>
            <th scope="col">Duration</th>
            <th scope="col">Price</th>
            <th scope="col"><span class="visually-hidden">Next step</span></th>
          </tr>
        </thead>
        <tbody>
          {treatments.map((t) => (
            <tr>
              <th scope="row" data-label="Treatment">
                <span class="c2-table__name">{treatmentTitle(t)}</span>
                <span class="c2-table__summary">{t.summary}</span>
              </th>
              <td data-label="Suited to">{t.suitedTo}</td>
              <td data-label="Scalp assessment"><Fact value={assessmentLabel(t.includesAssessment)} pending="To be confirmed" /></td>
              <td data-label="Duration"><Fact value={t.durationMinutes ? formatDuration(t.durationMinutes) : null} pending="To be confirmed" /></td>
              <td data-label="Price">
                <Fact value={t.price ? formatPrice(t.price) : null} pending="To be confirmed" />
                {t.price?.terms && <span class="c2-table__terms">{t.price.terms}</span>}
              </td>
              <td class="c2-table__action"><AppointmentAction variant="link" placement={`compare-${t.slug}`} context={treatmentTitle(t)} /></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="c2-choose__unsure">
        <p><strong>Not sure yet?</strong> Mention it in your request and your therapist can talk the options through with you.</p>
        <AppointmentAction placement="compare-unsure" />
      </div>
    </div>
  </section>

  <!-- Philosophy mapped onto moments of the visit -->
  <section id="approach" class="section c2-feel" aria-labelledby="c2-feel-title">
    <div class="container">
      <div class="c2-feel__head">
        <p class="t-eyebrow">Our approach</p>
        <h2 id="c2-feel-title" class="t-h2">How each part of the visit should feel</h2>
        <p>Health, Joy, Beauty and Vitality are the feelings we design each visit around.</p>
      </div>
      <ul role="list" class="c2-feel__list">
        {pillars.map((p) => (
          <li class="c2-feel__item">
            <p class="c2-feel__moment">{p.visitMoment}</p>
            <h3 class="t-h2">{p.name}</h3>
            <p class="c2-feel__meaning">{p.meaning}</p>
            <p>{p.description}</p>
            <a class="text-link" href={`#step-${pillarStep[p.name]}`}>See step {pillarStep[p.name]}<span class="visually-hidden">, {visitSteps[pillarStep[p.name] - 1].title}</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Finding us: the actual outlet and practical details -->
  <section id="space" class="section c2-space" aria-labelledby="c2-space-title">
    <div class="container grid c2-space__grid">
      <ImageSlot class="c2-space__image" assetId="entrance" ratio="3 / 2" tone="stone" sizes="(min-width: 1024px) 680px, 100vw" />
      <div class="c2-space__text">
        <p class="t-eyebrow">Finding us</p>
        <h2 id="c2-space-title" class="t-h2">Our space at Wheelock Place</h2>
        <p>{outlet.description}</p>
        <ul class="c2-space__features">
          {outlet.features.map((f) => <li>{f}</li>)}
        </ul>
        <ContactChannels />
      </div>
    </div>
  </section>

  <section id="faqs" class="section c2-faq" aria-labelledby="c2-faq-title">
    <div class="container c2-faq__inner">
      <p class="t-eyebrow">Questions</p>
      <h2 id="c2-faq-title" class="t-h2">Practical questions</h2>
      <Faq openFirst />
    </div>
  </section>

  <!-- Closing: requesting an appointment, as three honest steps -->
  <section id="appointment" class="section c2-close on-dark" aria-labelledby="c2-close-title">
    <div class="container">
      <h2 id="c2-close-title" class="t-h1">Ready for your first visit?</h2>
      <ol role="list" class="c2-close__steps">
        <li><span aria-hidden="true">1</span><p><strong>Choose a treatment.</strong> Or tell us you would like help choosing.</p></li>
        <li><span aria-hidden="true">2</span><p><strong>Send a request.</strong> Include the treatment and when you would prefer to come.</p></li>
        <li><span aria-hidden="true">3</span><p><strong>Wait for KOMO to confirm.</strong> Your appointment is only confirmed when KOMO confirms it with you.</p></li>
      </ol>
      <AppointmentPanel tone="dark" />
    </div>
  </section>
</main>

<SiteFooter nav={nav} />

<style>
  /* ---------- Hero ---------- */
  .c2-hero { padding-block: var(--space-12) var(--space-8); }
  .c2-hero__grid { row-gap: var(--space-8); margin-bottom: var(--space-12); align-items: start; }
  .c2-hero__text { grid-column: 1 / -1; display: grid; gap: var(--space-6); }
  .c2-glance { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .c2-hero { padding-top: var(--space-20); }
    .c2-hero__text { grid-column: 1 / span 7; }
    .c2-glance { grid-column: 9 / -1; }
  }
  .c2-glance {
    padding: var(--space-6);
    background: var(--komo-surface);
    border: 1px solid var(--komo-border);
    border-radius: var(--radius-card);
  }
  .c2-glance__title { font-weight: 500; margin-bottom: var(--space-3); }
  .c2-glance__list { display: grid; }
  .c2-glance__link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-top: 1px solid var(--komo-border);
    text-decoration: none;
  }
  .c2-glance__link:hover .c2-glance__step { text-decoration: underline; text-underline-offset: 0.2em; }
  .c2-glance__num { font-family: var(--font-editorial); font-size: 1.25rem; }
  .c2-glance__step { display: block; font-weight: 500; }
  .c2-glance__short { display: block; font-size: var(--text-support); color: var(--komo-text-secondary); }

  /* ---------- Journey timeline ---------- */
  .c2-journey__head, .c2-choose__head, .c2-feel__head { display: grid; gap: var(--space-4); max-width: 40em; }
  .c2-steps { position: relative; margin-top: var(--space-12); display: grid; gap: var(--space-16); }
  .c2-steps::before {
    content: '';
    position: absolute;
    top: 24px; bottom: 24px; left: 23px;
    width: 2px;
    background: var(--komo-sage);
  }
  .c2-step {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-6);
  }
  .c2-step__marker { grid-column: 1; grid-row: 1 / span 2; }
  .c2-step__marker span {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--komo-olive);
    color: var(--komo-ivory);
    font-family: var(--font-editorial);
    font-size: 1.25rem;
  }
  .c2-step__content { grid-column: 2; display: grid; gap: var(--space-3); align-content: start; }
  :global(.c2-step__image) { grid-column: 2; }
  .c2-step__count { font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--komo-text-secondary); }
  .c2-step__detail { font-size: var(--text-sub); line-height: 1.5; max-width: 34em; }
  .c2-step__notes { margin-top: var(--space-2); padding: var(--space-4) var(--space-6); background: var(--komo-surface); border-radius: var(--radius-card); border: 1px solid var(--komo-border); }
  .c2-step__notes-title { font-weight: 500; margin-bottom: var(--space-2); }
  .c2-step__notes ul { margin: 0; padding-left: 1.1em; display: grid; gap: var(--space-2); }
  @media (min-width: 1024px) {
    .c2-steps { gap: var(--space-24); }
    .c2-steps::before { left: 31px; }
    .c2-step { grid-template-columns: 64px repeat(11, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: center; }
    .c2-step__marker { grid-row: 1; align-self: start; }
    .c2-step__marker span { width: 64px; height: 64px; font-size: 1.5rem; }
    .c2-step__content { grid-column: 2 / span 5; grid-row: 1; }
    :global(.c2-step__image) { grid-column: 8 / -1; grid-row: 1; }
    .c2-step--reverse .c2-step__content { grid-column: 8 / -1; }
    .c2-step--reverse :global(.c2-step__image) { grid-column: 2 / span 5; }
  }

  /* ---------- Comparison table ---------- */
  .c2-choose { background: var(--komo-surface); }
  .c2-table { width: 100%; margin-top: var(--space-12); border-collapse: collapse; text-align: left; font-size: var(--text-support); }
  .c2-table th, .c2-table td { padding: var(--space-4); vertical-align: top; }
  .c2-table thead th { font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--komo-text-secondary); border-bottom: 2px solid var(--komo-olive); }
  .c2-table tbody tr { border-bottom: 1px solid var(--komo-border); }
  .c2-table tbody th { font-weight: 400; width: 30%; }
  .c2-table__name { display: block; font-family: var(--font-editorial); font-size: var(--text-card); line-height: 1.3; margin-bottom: var(--space-2); }
  .c2-table__summary { display: block; }
  .c2-table__terms { display: block; color: var(--komo-text-secondary); }
  .c2-table__action { white-space: nowrap; }
  @media (max-width: 1023.98px) {
    .c2-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .c2-table, .c2-table tbody, .c2-table tr, .c2-table th, .c2-table td { display: block; width: 100%; }
    .c2-table tbody tr {
      margin-bottom: var(--space-6);
      padding: var(--space-4) var(--space-2);
      background: var(--komo-ivory);
      border: 1px solid var(--komo-border);
      border-radius: var(--radius-card);
    }
    .c2-table tbody th { width: 100%; }
    .c2-table td { display: grid; grid-template-columns: minmax(7.5em, 35%) 1fr; gap: var(--space-3); padding-block: var(--space-2); }
    .c2-table td::before { content: attr(data-label); font-weight: 500; color: var(--komo-text-secondary); }
    .c2-table td.c2-table__action { display: block; white-space: normal; padding-top: var(--space-4); }
    .c2-table td.c2-table__action::before { content: none; }
  }
  .c2-choose__unsure { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); align-items: center; justify-content: space-between; padding: var(--space-6); border-radius: var(--radius-card); background: var(--komo-ivory); border: 1px solid var(--komo-border); }
  .c2-choose__unsure p { max-width: 40em; }

  /* ---------- How it should feel ---------- */
  .c2-feel__list { margin-top: var(--space-12); display: grid; gap: var(--space-12) var(--grid-gap); }
  .c2-feel__item { display: grid; gap: var(--space-2); align-content: start; justify-items: start; padding: var(--space-6); background: var(--komo-surface); border-radius: var(--radius-card); border-top: 4px solid var(--komo-sage); }
  .c2-feel__meaning { color: var(--komo-text-secondary); font-size: var(--text-support); }
  .c2-feel__moment { font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--komo-text-secondary); }
  @media (min-width: 768px) { .c2-feel__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .c2-feel__list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* ---------- Space ---------- */
  .c2-space { background: var(--komo-surface); border-top: 1px solid var(--komo-border); }
  .c2-space__grid { row-gap: var(--space-8); }
  :global(.c2-space__image), .c2-space__text { grid-column: 1 / -1; }
  .c2-space__text { display: grid; gap: var(--space-4); align-content: start; }
  .c2-space__features { margin: 0 0 var(--space-4); padding-left: 1.1em; display: grid; gap: var(--space-1); }
  @media (min-width: 1024px) {
    :global(.c2-space__image) { grid-column: 1 / span 7; }
    .c2-space__text { grid-column: 9 / -1; }
  }

  /* ---------- FAQ ---------- */
  .c2-faq__inner { display: grid; gap: var(--space-4); max-width: calc(var(--reading-max) + 2 * var(--gutter)); margin-inline: 0; }
  .c2-faq__inner :global(.faq) { margin-top: var(--space-6); }
  @media (min-width: 1024px) { .c2-faq__inner { margin-inline: auto; } }

  /* ---------- Closing ---------- */
  .c2-close { background: var(--komo-olive); color: var(--komo-ivory); }
  .c2-close h2 { color: var(--komo-ivory); max-width: 16em; }
  .c2-close__steps { margin: var(--space-12) 0; display: grid; gap: var(--space-6); }
  .c2-close__steps li { display: grid; grid-template-columns: 48px 1fr; gap: var(--space-4); align-items: start; padding-top: var(--space-4); border-top: 1px solid rgba(244, 240, 231, 0.35); }
  .c2-close__steps span { font-family: var(--font-editorial); font-size: var(--text-h2); line-height: 1; }
  @media (min-width: 1024px) { .c2-close__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); } }
</style>
