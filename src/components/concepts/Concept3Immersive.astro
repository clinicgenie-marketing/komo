---
/**
 * Concept 3: Immersive retreat.
 * A wide atmospheric hero with an adjacent text panel (no text over the photo),
 * spacious sensory imagery, concise service information and clear appointment
 * guidance. Depth comes from deliberate changes in image scale. Still imagery only.
 */
import PreviewBanner from '../layout/PreviewBanner.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import ContactChannels from '../layout/ContactChannels.astro';
import ImageSlot from '../ui/ImageSlot.astro';
import AppointmentAction from '../ui/AppointmentAction.astro';
import AppointmentPanel from '../ui/AppointmentPanel.astro';
import TreatmentFacts from '../ui/TreatmentFacts.astro';
import Faq from '../ui/Faq.astro';
import { copy, experienceParts, outlet, pillars, treatments, visitSteps } from '../../data/records.ts';
import { treatmentTitle } from '../../lib/format.ts';

const nav = [
  { href: '#treatments', label: 'Treatments' },
  { href: '#space', label: 'Our space' },
  { href: '#first-visit', label: 'Your first visit' },
  { href: '#faqs', label: 'FAQs' },
];
const [health, joy, beauty, vitality] = pillars;
---
<PreviewBanner concept="Concept 3, Immersive retreat" />
<SiteHeader nav={nav} homeHref="/concept-3/" sticky={false} hideCtaOnMobile />

<main id="main" class="c3" tabindex="-1">
  <!-- Hero: full-bleed photograph with an adjacent soft-white text panel -->
  <section class="c3-hero" aria-labelledby="c3-hero-title">
    <ImageSlot
      class="c3-hero__image"
      assetId="treatment-hero"
      ratio="16 / 9"
      ratioMobile="4 / 5"
      tone="stone"
      loading="eager"
      sizes="100vw"
      bleed
    />
    <div class="container c3-hero__panel-wrap">
      <div class="c3-hero__panel">
        <p class="t-eyebrow">Scalp and hair wellness at Wheelock Place</p>
        <h1 id="c3-hero-title" class="t-display">A restorative pause for your scalp and hair.</h1>
        <p class="t-lead">{copy.heroSupport.text}</p>
        <div class="button-row">
          <AppointmentAction placement="hero" />
          <a class="komo-button komo-button--secondary" href="#treatments">Explore treatments</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sensory interlude: large and small images at different scales -->
  <section class="section c3-sense" aria-labelledby="c3-sense-title">
    <div class="container grid c3-sense__grid">
      <ImageSlot class="c3-sense__large" assetId="water-detail" ratio="4 / 5" ratioMobile="4 / 5" tone="sage" sizes="(min-width: 1024px) 680px, 100vw" />
      <div class="c3-sense__text">
        <h2 id="c3-sense-title" class="t-h1">Water, touch and time.</h2>
        <p class="t-lead">{copy.experienceIntro.text}</p>
      </div>
      <ImageSlot class="c3-sense__small" assetId="linen-detail" ratio="1 / 1" tone="timber" sizes="(min-width: 1024px) 380px, 60vw" />
    </div>
    <div class="container">
      <ul role="list" class="c3-parts">
        {experienceParts.map((p) => (
          <li>
            <h3 class="t-sub">{p.title}</h3>
            <p class="t-support">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Philosophy: paired images with alternating scale -->
  <section id="approach" class="section c3-pillars" aria-labelledby="c3-pillars-title">
    <div class="container">
      <div class="c3-pillars__head">
        <p class="t-eyebrow">Our approach</p>
        <h2 id="c3-pillars-title" class="t-h2">Health, Joy, Beauty and Vitality</h2>
      </div>
      <div class="c3-pair">
        <figure class="c3-pillar c3-pillar--wide">
          <ImageSlot assetId={health.assetId} ratio="4 / 3" ratioMobile="4 / 3" tone="stone" sizes="(min-width: 1024px) 680px, 100vw" />
          <figcaption><span class="c3-pillar__name">{health.name}</span> {health.description}</figcaption>
        </figure>
        <figure class="c3-pillar c3-pillar--narrow">
          <ImageSlot assetId={joy.assetId} ratio="3 / 4" ratioMobile="4 / 3" tone="sage" sizes="(min-width: 1024px) 460px, 100vw" />
          <figcaption><span class="c3-pillar__name">{joy.name}</span> {joy.description}</figcaption>
        </figure>
      </div>
      <div class="c3-pair c3-pair--reverse">
        <figure class="c3-pillar c3-pillar--narrow">
          <ImageSlot assetId={beauty.assetId} ratio="3 / 4" ratioMobile="4 / 3" tone="timber" sizes="(min-width: 1024px) 460px, 100vw" />
          <figcaption><span class="c3-pillar__name">{beauty.name}</span> {beauty.description}</figcaption>
        </figure>
        <figure class="c3-pillar c3-pillar--wide">
          <ImageSlot assetId={vitality.assetId} ratio="4 / 3" ratioMobile="4 / 3" tone="stone" sizes="(min-width: 1024px) 680px, 100vw" />
          <figcaption><span class="c3-pillar__name">{vitality.name}</span> {vitality.description}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Treatments: concise, text-led on olive for a change of pace -->
  <section id="treatments" class="section c3-treatments on-dark" aria-labelledby="c3-treatments-title">
    <div class="container">
      <div class="c3-treatments__head">
        <h2 id="c3-treatments-title" class="t-h2">Choose your care</h2>
        <p>Three kinds of care. Each begins with a conversation about you.</p>
      </div>
      <ul role="list" class="c3-treatments__list">
        {treatments.map((t) => (
          <li class="c3-treatment">
            <p class="c3-treatment__focus">{t.focus}</p>
            <h3 class="t-card-serif">{treatmentTitle(t)}</h3>
            <p>{t.summary}</p>
            <TreatmentFacts treatment={t} />
            <AppointmentAction variant="secondary-on-dark" placement={`treatment-${t.slug}`} context={treatmentTitle(t)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The outlet: full-bleed architecture with an overlapping panel -->
  <section id="space" class="c3-space" aria-labelledby="c3-space-title">
    <ImageSlot class="c3-space__image" assetId="flow-architecture" ratio="21 / 9" ratioMobile="1 / 1" tone="timber" sizes="100vw" bleed />
    <div class="container c3-space__panel-wrap">
      <div class="c3-space__panel">
        <p class="t-eyebrow">Our space</p>
        <h2 id="c3-space-title" class="t-h2">A light retreat at Wheelock Place</h2>
        <p>{outlet.description}</p>
        <ul class="c3-space__features">
          {outlet.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- First visit: portrait beside a compact numbered sequence -->
  <section id="first-visit" class="section c3-visit" aria-labelledby="c3-visit-title">
    <div class="container grid c3-visit__grid">
      <ImageSlot class="c3-visit__image" assetId="therapist-portrait" ratio="3 / 4" ratioMobile="3 / 2" tone="sage" sizes="(min-width: 1024px) 380px, 100vw" />
      <div class="c3-visit__text">
        <p class="t-eyebrow">Your first visit</p>
        <h2 id="c3-visit-title" class="t-h2">What to expect</h2>
        <ol role="list" class="c3-visit__steps">
          {visitSteps.map((s) => (
            <li>
              <span class="c3-visit__num" aria-hidden="true">{String(s.order).padStart(2, '0')}</span>
              <div>
                <h3 class="t-sub">{s.title}{s.conditional && <span class="tag c3-visit__tag">{s.conditionNote}</span>}</h3>
                <p class="t-support">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Appointment guidance: prominent and practical -->
  <section id="appointment" class="section c3-appt" aria-labelledby="c3-appt-title">
    <div class="container grid c3-appt__grid">
      <div class="c3-appt__lead">
        <h2 id="c3-appt-title" class="t-h1">Requesting an appointment</h2>
        <p class="t-lead">Let us know which treatment interests you and when you would prefer to come. If you are unsure which to choose, say so and your therapist can help.</p>
        <AppointmentPanel />
      </div>
      <div class="c3-appt__details">
        <h3 class="t-sub">Contact and visit details</h3>
        <ContactChannels />
      </div>
    </div>
  </section>

  <section id="faqs" class="section c3-faq" aria-labelledby="c3-faq-title">
    <div class="container grid">
      <h2 id="c3-faq-title" class="t-h2 c3-faq__title">Questions, answered simply</h2>
      <Faq class="c3-faq__list" />
    </div>
  </section>
</main>

<SiteFooter nav={nav} />

<!-- Persistent appointment action on small screens. The body is padded so it never covers content. -->
<aside class="c3-actionbar" aria-label="Appointment" data-actionbar>
  <AppointmentAction placement="mobile-bar" class="c3-actionbar__button" />
</aside>

<style>
  /* ---------- Hero ---------- */
  .c3-hero { position: relative; }
  .c3-hero__panel-wrap { position: relative; margin-top: calc(-1 * var(--space-12)); }
  .c3-hero__panel {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-6);
    background: var(--komo-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }
  @media (min-width: 768px) {
    :global(.c3-hero__image .slot__media) { max-height: 78vh; min-height: 420px; }
    .c3-hero__panel-wrap { margin-top: calc(-1 * var(--space-30)); }
    .c3-hero__panel { max-width: 640px; padding: var(--space-12); }
  }

  /* ---------- Sensory ---------- */
  .c3-sense { padding-top: var(--space-24); }
  .c3-sense__grid { row-gap: var(--space-8); align-items: end; }
  :global(.c3-sense__large), .c3-sense__text { grid-column: 1 / -1; }
  :global(.c3-sense__small) { grid-column: 2 / -1; }
  .c3-sense__text { display: grid; gap: var(--space-6); }
  @media (min-width: 768px) {
    :global(.c3-sense__large) { grid-column: 1 / span 5; grid-row: 1 / span 2; }
    .c3-sense__text { grid-column: 6 / -1; grid-row: 1; align-self: start; }
    :global(.c3-sense__small) { grid-column: 6 / -1; grid-row: 2; }
  }
  @media (min-width: 1024px) {
    :global(.c3-sense__large) { grid-column: 1 / span 7; }
    .c3-sense__text { grid-column: 9 / -1; padding-top: var(--space-16); }
    :global(.c3-sense__small) { grid-column: 9 / -1; }
  }
  .c3-parts { margin-top: var(--space-16); display: grid; gap: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--komo-border); }
  .c3-parts li { display: grid; gap: var(--space-2); }
  @media (min-width: 768px) { .c3-parts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* ---------- Pillars ---------- */
  .c3-pillars__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-12); }
  .c3-pair { display: grid; gap: var(--space-12); margin-bottom: var(--space-16); }
  .c3-pillar { margin: 0; display: grid; gap: var(--space-4); }
  .c3-pillar figcaption { max-width: 30em; }
  .c3-pillar__name { display: block; font-family: var(--font-editorial); font-size: var(--text-card); line-height: 1.3; }
  @media (min-width: 768px) {
    .c3-pair { grid-template-columns: 7fr 5fr; column-gap: var(--grid-gap); align-items: end; }
    .c3-pair--reverse { grid-template-columns: 5fr 7fr; align-items: start; }
    .c3-pillar--narrow { padding-bottom: var(--space-16); }
    .c3-pair--reverse .c3-pillar--narrow { padding-bottom: 0; padding-top: var(--space-16); }
  }

  /* ---------- Treatments ---------- */
  .c3-treatments { background: var(--komo-olive); color: var(--komo-ivory); }
  .c3-treatments h2, .c3-treatments h3 { color: var(--komo-ivory); }
  .c3-treatments__head { display: grid; gap: var(--space-3); max-width: 36em; }
  .c3-treatments__list { margin-top: var(--space-12); display: grid; gap: var(--space-8); }
  .c3-treatment { display: grid; gap: var(--space-4); align-content: start; justify-items: start; padding-top: var(--space-6); border-top: 1px solid rgba(244, 240, 231, 0.4); }
  .c3-treatment__focus { font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  @media (min-width: 768px) { .c3-treatments__list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--grid-gap); } }

  /* ---------- Space ---------- */
  .c3-space { position: relative; padding-bottom: var(--section-pad); }
  .c3-space__panel-wrap { position: relative; margin-top: calc(-1 * var(--space-12)); display: flex; justify-content: flex-end; }
  .c3-space__panel {
    display: grid; gap: var(--space-4);
    max-width: 560px;
    padding: var(--space-8) var(--space-6);
    background: var(--komo-ivory);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }
  .c3-space__features { margin: 0; padding-left: 1.1em; display: grid; gap: var(--space-1); }
  @media (min-width: 768px) {
    .c3-space__panel-wrap { margin-top: calc(-1 * var(--space-24)); }
    .c3-space__panel { padding: var(--space-12); }
  }

  /* ---------- First visit ---------- */
  .c3-visit { background: var(--komo-surface); }
  .c3-visit__grid { row-gap: var(--space-8); align-items: center; }
  :global(.c3-visit__image), .c3-visit__text { grid-column: 1 / -1; }
  .c3-visit__text { display: grid; gap: var(--space-3); }
  @media (min-width: 768px) {
    :global(.c3-visit__image) { grid-column: 1 / span 3; }
    .c3-visit__text { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    :global(.c3-visit__image) { grid-column: 1 / span 4; }
    .c3-visit__text { grid-column: 6 / -1; }
  }
  .c3-visit__steps { margin-top: var(--space-6); display: grid; }
  .c3-visit__steps li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-4); padding-block: var(--space-4); border-top: 1px solid var(--komo-border); }
  .c3-visit__num { font-family: var(--font-editorial); font-size: 1.5rem; line-height: 1.2; color: var(--komo-text-secondary); }
  .c3-visit__tag { margin-left: var(--space-3); vertical-align: middle; }

  /* ---------- Appointment ---------- */
  .c3-appt { background: var(--komo-stone); }
  .c3-appt__grid { row-gap: var(--space-12); }
  .c3-appt__lead, .c3-appt__details { grid-column: 1 / -1; display: grid; gap: var(--space-6); align-content: start; }
  @media (min-width: 1024px) {
    .c3-appt__lead { grid-column: 1 / span 7; }
    .c3-appt__details { grid-column: 9 / -1; }
  }

  /* ---------- FAQ ---------- */
  .c3-faq__title { grid-column: 1 / -1; margin-bottom: var(--space-8); }
  :global(.c3-faq__list) { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .c3-faq__title { grid-column: 3 / span 8; }
    :global(.c3-faq__list) { grid-column: 3 / span 8; }
  }

  /* ---------- Mobile action bar ---------- */
  .c3-actionbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--komo-ivory);
    border-top: 1px solid var(--komo-border);
  }
  .c3-actionbar :global(.c3-actionbar__button) { width: 100%; }
  :global(body:has(.c3-actionbar)) { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
  @media (min-width: 1024px) {
    .c3-actionbar { display: none; }
    :global(body:has(.c3-actionbar)) { padding-bottom: 0; }
  }
</style>
