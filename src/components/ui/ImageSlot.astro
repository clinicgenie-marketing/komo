---
/**
 * Image slot driven by the asset register.
 *
 * - An approved documentary asset renders as a responsive <img> in every build.
 * - A supplied concept image (src set, not yet approved) renders in preview
 *   builds only, marked with data-asset-status="concept"; the production build
 *   throws so it cannot be published by accident (SG 13.2, Rules 6).
 * - With no file, a labelled placeholder reserves the same aspect ratio.
 *
 * Shapes follow the outlet architecture (SG 5, 10.3): 'arch' for the backlit
 * timber niches, 'circle' for the round illuminated mirrors and porthole.
 * Never use a shape that crops a face or the key treatment action.
 */
import { Image } from 'astro:assets';
import { getAsset } from '../../data/records.ts';
import { isPreview, isPublishable } from '../../lib/publication.ts';
import { resolveImage } from '../../lib/images.ts';

interface Props {
  assetId: string;
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio: string;
  /** Optional aspect ratio below 768px. */
  ratioMobile?: string;
  tone?: 'stone' | 'sage' | 'surface' | 'olive' | 'timber';
  loading?: 'eager' | 'lazy';
  sizes?: string;
  /** Shorthand for shape="arch". */
  arch?: boolean;
  shape?: 'rect' | 'arch' | 'circle';
  /** Warm halo of the illuminated mirrors. Use sparingly. */
  glow?: boolean;
  /** Override the record's focal point, e.g. "40% 30%". */
  position?: string;
  caption?: string;
  class?: string;
  /** Fill the parent's height instead of using the aspect ratio (desktop only). */
  fill?: boolean;
  /** Full-bleed slot: square corners, placeholder label aligned to the page container. */
  bleed?: boolean;
}
const {
  assetId, ratio, ratioMobile, tone = 'stone', loading = 'lazy', sizes = '100vw',
  arch = false, shape: shapeProp, glow = false, position, caption, class: className,
  fill = false, bleed = false,
} = Astro.props;
const shape = shapeProp ?? (arch ? 'arch' : 'rect');
const a = getAsset(assetId);
const approved = a.src !== null && isPublishable(a);
const conceptImage = a.src !== null && !approved && isPreview;
if (!approved && !isPreview) {
  throw new Error(`Asset "${assetId}" is not approved; production build blocked.`);
}
const file = approved || conceptImage ? resolveImage(a.src!) : null;
const widths = file ? [480, 800, 1200, 1600].filter((w) => w < file.width).concat(file.width) : [];
const focal = position ?? (/%|px|top|bottom|left|right|center/.test(a.focalPoint) ? a.focalPoint : '50% 50%');
const style = `--slot-ratio: ${ratio}; --slot-ratio-mobile: ${ratioMobile ?? ratio}; --slot-position: ${focal};`;
---
<figure
  class:list={['slot', `slot--${tone}`, `slot--${shape}`, { 'slot--glow': glow, 'slot--fill': fill, 'slot--bleed': bleed }, className]}
  style={style}
  data-asset-status={file ? (approved ? 'approved' : 'concept') : 'placeholder'}
>
  {file ? (
    <Image
      class="slot__media slot__photo"
      src={file}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      alt={a.decorative ? '' : a.alt}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
  ) : (
    <div class="slot__media slot__placeholder" role="img" aria-label={`Photograph placeholder: ${a.subject}`}>
      <span class="slot__label" aria-hidden="true">
        <span class="slot__kicker">Photograph required</span>
        <span class="slot__ref">{a.shotRef}</span>
        <span class="slot__brief">{a.brief}</span>
      </span>
    </div>
  )}
  {caption && <figcaption class="slot__caption">{caption}</figcaption>}
</figure>

<style>
  .slot { position: relative; min-width: 0; }
  .slot__media {
    width: 100%;
    aspect-ratio: var(--slot-ratio-mobile);
    object-fit: cover;
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .slot__photo {
    display: block;
    height: auto;
    object-position: var(--slot-position, 50% 50%);
    background: var(--komo-oak-light);
  }
  @media (min-width: 768px) {
    .slot__media { aspect-ratio: var(--slot-ratio); }
    .slot--fill { height: 100%; }
    .slot--fill .slot__media { height: 100%; aspect-ratio: auto; min-height: 100%; }
  }
  .slot--arch .slot__media { border-radius: var(--radius-arch); }
  .slot--circle .slot__media { border-radius: 50%; aspect-ratio: 1 / 1; }
  .slot--glow .slot__media { box-shadow: var(--glow-halo); }

  .slot__placeholder {
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    color: var(--komo-olive);
  }
  .slot--stone .slot__placeholder { background: var(--komo-stone); }
  .slot--sage .slot__placeholder { background: var(--komo-sage); }
  .slot--surface .slot__placeholder { background: var(--komo-surface); box-shadow: inset 0 0 0 1px var(--komo-border); }
  .slot--timber .slot__placeholder { background: var(--komo-oak-light); }
  .slot--olive .slot__placeholder { background: var(--komo-action-hover); color: var(--komo-ivory); }
  .slot--arch .slot__placeholder,
  .slot--circle .slot__placeholder { align-items: center; justify-content: center; text-align: center; padding-inline: 18%; }

  .slot--bleed .slot__media { border-radius: 0; }
  .slot--bleed .slot__placeholder {
    align-items: flex-start;
    padding: var(--space-6) max(var(--gutter), calc((100% - var(--container-max)) / 2));
  }
  .slot__label {
    display: grid;
    gap: var(--space-1);
    max-width: 30em;
    font-size: var(--text-eyebrow);
    line-height: 1.45;
  }
  .slot__kicker { font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .slot__ref { font-weight: 500; }
  .slot__brief { font-size: 0.8125rem; }
  .slot__caption {
    margin-top: var(--space-3);
    font-size: var(--text-support);
    line-height: 1.5;
    color: var(--komo-text-secondary);
  }
</style>
