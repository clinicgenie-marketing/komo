---
/**
 * Placeholder for the official KOMO master logo (style guide 6.1).
 * The logo is not reconstructed from a typeface. Replace this component's
 * contents with the approved vector artwork when it is supplied (Task.md D06).
 */
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: className } = Astro.props;
---
<span class:list={['logo-slot', `logo-slot--${tone}`, className]} aria-hidden="true">
  <span class="logo-slot__name">KOMO logo</span>
  <span class="logo-slot__note">official artwork required</span>
</span>

<style>
  .logo-slot {
    display: inline-grid;
    place-content: center;
    min-width: 132px;
    min-height: 44px;
    padding: var(--space-1) var(--space-4);
    border: 1px dashed currentColor;
    border-radius: 999px;
    text-align: center;
    line-height: 1.15;
    font-family: var(--font-display);
  }
  .logo-slot--light { color: var(--komo-olive); }
  .logo-slot--dark { color: var(--komo-ivory); }
  .logo-slot__name { font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; }
  .logo-slot__note { font-size: 0.625rem; letter-spacing: 0.04em; opacity: 0.85; }
</style>
