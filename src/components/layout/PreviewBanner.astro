---
/** Visible draft status for the private preview (Architecture.md 4). Not sticky. */
interface Props { concept?: string }
const { concept } = Astro.props;
---
<aside class="preview-banner" aria-label="Preview status">
  <div class="container preview-banner__inner">
    <p>
      <strong>Private concept preview{concept && `: ${concept}`}.</strong>{' '}
      Copy is draft. Photographs are supplied concept images, not confirmed records of KOMO’s premises, staff or results. The logo, prices, durations, contact details and booking destination are labelled placeholders until KOMO confirms them.
    </p>
    <a class="preview-banner__link" href="/concepts/">Compare all concepts</a>
  </div>
</aside>

<style>
  .preview-banner {
    background: var(--komo-surface);
    border-bottom: 1px solid var(--komo-border);
    font-size: var(--text-support);
    line-height: 1.5;
  }
  .preview-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-3);
  }
  .preview-banner p { max-width: 80ch; }
  .preview-banner__link { font-weight: 500; white-space: nowrap; min-height: 24px; display: inline-flex; align-items: center; }
</style>
